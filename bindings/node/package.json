{
  "name": "@polyjose/node",
  "version": "0.2.0",
  "description": "polyjose for Node.js: JOSE (JWS, JWE, JWK, JWT) in pure Rust through Node-API, with the shared TypeScript facade (ADR 0031, ADR 0047).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharathkontham/polyjose.git",
    "directory": "bindings/node"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "backend.js",
    "backend.d.ts",
    "facade/*.js",
    "facade/*.d.ts",
    "polyjose.darwin-x64.node",
    "polyjose.darwin-arm64.node",
    "polyjose.linux-x64-gnu.node",
    "polyjose.linux-arm64-gnu.node",
    "polyjose.linux-x64-musl.node",
    "polyjose.linux-arm64-musl.node",
    "polyjose.win32-x64-msvc.node",
    "polyjose.win32-arm64-msvc.node",
    "addon-sha256.json",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "napi": {
    "binaryName": "polyjose",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "scripts/build.sh",
    "test": "./test.sh"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  }
}
