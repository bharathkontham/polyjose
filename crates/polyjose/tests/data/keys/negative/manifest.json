    "file": "N37-params-null-for-ec.der",
    "base": "rfc7517-a1-ec-p256-spki.der",
    "mutation": "id-ecPublicKey with NULL parameters",
    "expect": "InvalidKey",
    "cite": "RFC 5480 \u00a72.1.1 (implicitCurve NULL MUST NOT be used)"
  },
  {
    "id": "N38",
    "file": "N38-spki-trailing-field.der",
    "base": "rfc7517-a1-ec-p256-spki.der",
    "mutation": "extra NULL after subjectPublicKey",
    "expect": "InvalidKey",
    "cite": "RFC 5280 \u00a74.1.2.7 (exactly two fields)"
  },
  {
    "id": "N40",
