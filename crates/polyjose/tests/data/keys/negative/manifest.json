[
  {
    "id": "A01",
    "file": "A01-accept-crlf.pem",
    "base": "rfc8037-a1-ed25519-pkcs8.pem",
    "mutation": "CRLF line endings",
    "expect": "ok",
    "jwk": "rfc8037-a1-ed25519-pkcs8.jwk.json",
    "cite": "RFC 7468 \u00a73 (eol may be CRLF, CR or LF)"
  },
  {
    "id": "A02",
    "file": "A02-accept-no-final-newline.pem",
    "base": "rfc8037-a1-ed25519-pkcs8.pem",
    "mutation": "no newline after END line",
    "expect": "ok",
    "jwk": "rfc8037-a1-ed25519-pkcs8.jwk.json",
    "cite": "RFC 7468 \u00a73"
  },
  {
    "id": "A03",
    "file": "A03-accept-surrounding-whitespace.pem",
    "base": "rfc8037-a1-ed25519-pkcs8.pem",
    "mutation": "blank lines before and after",
    "expect": "ok",
    "jwk": "rfc8037-a1-ed25519-pkcs8.jwk.json",
    "cite": "ADR 0018: only whitespace may surround the block"
  },
  {
    "id": "N01",
    "file": "N01-len-long-form-for-short.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "outer length 0x2e written as 81 2e",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a710.1 (DER: definite form, minimum number of length octets)"
  },
  {
    "id": "N02",
    "file": "N02-len-leading-zero.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "outer length written as 82 00 2e",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a710.1 (DER: definite form, minimum number of length octets)"
  },
  {
    "id": "N03",
    "file": "N03-len-indefinite.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "indefinite length with end-of-contents",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a710.1, \u00a78.1.3.6 (indefinite form is BER only)"
  },
  {
    "id": "N04",
    "file": "N04-int-version-nonminimal.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "version INTEGER 0 encoded as 02 02 00 00",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a78.3.2 (INTEGER minimal octets)"
  },
  {
    "id": "N05",
    "file": "N05-octet-string-constructed.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "privateKey OCTET STRING split into a constructed (0x24) BER string",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a710.2 (DER: string types use the primitive form)"
  },
  {
    "id": "N06",
    "file": "N06-trailing-zero-byte.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "one 0x00 byte after the outer SEQUENCE",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a78.1.1 / RFC 5958 \u00a72: exactly one PrivateKeyInfo; no data may follow"
  },
  {
    "id": "N07",
    "file": "N07-trailing-second-key.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "the whole key repeated twice",
    "expect": "InvalidKey",
    "cite": "RFC 5958 \u00a72: exactly one OneAsymmetricKey"
  },
  {
    "id": "N08",
    "file": "N08-truncated.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "last content byte removed",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a78.1.3: length exceeds the available content"
  },
  {
    "id": "N09",
    "file": "N09-len-exceeds-input.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "outer length one larger than the content",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a78.1.3"
  },
  {
    "id": "N10",
    "file": "N10-high-tag-number.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "outer tag in high-tag-number form (0x3f 0x10)",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a78.1.2.4 (only SEQUENCE 0x30 is valid here)"
  },
  {
    "id": "N11",
    "file": "N11-len-five-octets.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "length in 5 octets",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a710.1 (DER: definite form, minimum number of length octets)"
  },
  {
    "id": "N12",
    "file": "N12-empty.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "zero bytes",
    "expect": "InvalidKey",
    "cite": "RFC 5958 \u00a72"
  },
  {
    "id": "N20",
    "file": "N20-ed25519-params-null.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "AlgorithmIdentifier for id-Ed25519 carries NULL parameters",
    "expect": "InvalidKey",
    "cite": "RFC 8410 \u00a73: parameters MUST be absent"
  },
  {
    "id": "N21",
    "file": "N21-oid-ed448.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "OID changed to id-Ed448 (1.3.101.113)",
    "expect": "UnsupportedAlgorithm",
    "cite": "ADR 0006: Ed448 out of scope; RFC 8410 \u00a73"
  },
  {
    "id": "N22",
    "file": "N22-oid-nonminimal-subid.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "OID 1.3.101.112 with subidentifier 101 encoded as 80 65",
    "expect": "InvalidKey",
    "cite": "X.690 \u00a78.19.2 (subidentifier uses the fewest octets; 0x80 lead byte forbidden)"
  },
  {
    "id": "N23",
    "file": "N23-version-2.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "version 2",
    "expect": "InvalidKey",
    "cite": "RFC 5958 \u00a72: version is v1(0) or v2(1)"
  },
  {
    "id": "N24",
    "file": "N24-v1-with-public-key.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "version 0 but [1] publicKey present",
    "expect": "InvalidKey",
    "cite": "RFC 5958 \u00a72: publicKey only in v2"
  },
  {
    "id": "N25",
    "file": "N25-curve-private-31-bytes.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "CurvePrivateKey of 31 octets",
    "expect": "InvalidKey",
    "cite": "RFC 8410 \u00a77; RFC 8032 \u00a75.1.5 (32 octets)"
  },
  {
    "id": "N26",
    "file": "N26-curve-private-not-octet-string.der",
    "base": "rfc8037-a1-ed25519-pkcs8.der",
    "mutation": "CurvePrivateKey wrapped in INTEGER instead of OCTET STRING",
    "expect": "InvalidKey",
    "cite": "RFC 8410 \u00a77: CurvePrivateKey ::= OCTET STRING"
  },
  {
    "id": "N27",
    "file": "N27-v2-public-key-mismatch.der",
    "base": "rfc8410-10.3-ed25519-pkcs8-v2-attr-pub.pem",
    "mutation": "last byte of the v2 [1] publicKey flipped",
    "expect": "InvalidKey",
    "cite": "RFC 5958 \u00a72 (publicKey is the key's public half); ADR 0018 consistency check"
  },
  {
    "id": "N30",
    "file": "N30-bitstring-unused-bits.der",
    "base": "rfc7517-a1-ec-p256-spki.der",
    "mutation": "subjectPublicKey BIT STRING with 1 unused bit",
    "expect": "InvalidKey",
    "cite": "RFC 5480 \u00a72.2 / X.690 \u00a711.2.1 (key is a whole number of octets)"
  },
  {
    "id": "N31",
    "file": "N31-point-off-curve.der",
    "base": "rfc7517-a1-ec-p256-spki.der",
    "mutation": "last byte of y flipped",
    "expect": "InvalidKey",
    "cite": "RFC 8725 \u00a73.4; SEC 1 v2 \u00a73.2.2.1 (point must be on the curve)"
  },
  {
    "id": "N32",
    "file": "N32-ec-no-parameters.der",
    "base": "rfc7517-a1-ec-p256-spki.der",
    "mutation": "id-ecPublicKey without namedCurve",
    "expect": "InvalidKey",
    "cite": "RFC 5480 \u00a72.1.1: parameters MUST be present"
  },
  {
    "id": "N33",
    "file": "N33-curve-secp224r1.der",
    "base": "rfc7517-a1-ec-p256-spki.der",
