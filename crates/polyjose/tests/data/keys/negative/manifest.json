    "base": "rfc7517-a1-rsa-spki.der",
    "mutation": "rsaEncryption without the NULL parameters",
    "expect": "InvalidKey",
    "cite": "RFC 3279 \u00a72.3.1 (MUST be NULL); RFC 8017 App. A.1 (SHALL be NULL)"
  },
  {
    "id": "N61",
