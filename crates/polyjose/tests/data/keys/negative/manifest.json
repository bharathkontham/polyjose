  },
  {
    "id": "N42",
    "file": "N42-sec1-d-equals-n.der",
    "base": "rfc7517-a2-ec-p256-sec1.der",
    "mutation": "private key = group order n",
    "expect": "InvalidKey",
    "cite": "SEC 1 v2 \u00a73.2.1: d in [1, n-1]"
  },
  {
    "id": "N43",
    "file": "N43-sec1-d-31-bytes.der",
    "base": "rfc7517-a2-ec-p256-sec1.der",
    "mutation": "privateKey of 31 octets",
    "expect": "InvalidKey",
    "cite": "RFC 5915 \u00a73: ceiling(log2(n)/8) octets"
  },
  {
    "id": "N44",
