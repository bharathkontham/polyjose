  {
    "id": "N69",
    "file": "N69-rsa-private-pkcs1-as-sec1.der",
    "base": "reject-rsa2048-private-pkcs1.der",
    "mutation": "the PKCS#1 RSAPrivateKey bytes unchanged, read as SEC1",
    "expect": "UnsupportedAlgorithm",
    "cite": "ADR 0018 \u00a73 (RSA private, any format: UnsupportedAlgorithm); ADR 0021; RFC 8017 App. A.1.2"
  },
  {
