  },
  {
    "id": "N35",
    "file": "N35-point-hybrid-prefix.der",
    "base": "rfc7517-a1-ec-p256-spki.der",
    "mutation": "point prefix 0x06 (hybrid form)",
    "expect": "InvalidKey",
    "cite": "RFC 5480 \u00a72.2 (only uncompressed and compressed forms)"
  },
  {
    "id": "N36",
    "file": "N36-point-identity.der",
    "base": "rfc7517-a1-ec-p256-spki.der",
    "mutation": "point at infinity (single 0x00)",
    "expect": "InvalidKey",
    "cite": "SEC 1 v2 \u00a72.3.3; RFC 8725 \u00a73.4"
  },
  {
