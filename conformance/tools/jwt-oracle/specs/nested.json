        "alg": "ES256",
        "key": {
          "$key": "p256"
        },
        "encrypt": {
          "alg": "ECDH-ES+A128KW",
          "enc": "A128GCM",
          "key": {
            "$public": "p256-ecdh"
          }
        },
        "validate": {
          "now": 1300819320,
          "allowed_algs": [
            "ES256"
          ],
          "key": {
            "$public": "p256"
          },
          "decrypt": {
            "key": {
              "$key": "p256-ecdh"
            },
            "allowed_algs": [
              "ECDH-ES+A128KW"
            ],
            "allowed_enc": [
              "A128GCM"
            ]
          }
        }
      },
      "expect": {
        "ok": true
      }
    },
